# Outshift QRNG API Configuration Template
# Copy this to .env and add your actual API key
QRNG_OUTSHIFT_API_KEY=your_api_key_here
QRNG_OUTSHIFT_API_URL=https://api.qrng.outshift.com/api/v1/random_numbers

# Cipherstone Qbert QRNG Configuration (optional)
# Public API keys are provided as defaults in the code
# Override these only if you have custom keys
# CIPHERSTONE_QRNG_MODE1_KEY=your_mode1_key_here
# CIPHERSTONE_QRNG_MODE2_KEY=your_mode2_key_here
# CIPHERSTONE_QRNG_API_URL=https://qbert.cipherstone.co/
